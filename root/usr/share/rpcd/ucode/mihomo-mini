'use strict';
import * as fs from 'fs';
import * as m from 'mihomo-mini';

function squad_observations(country, path) {
	let feed = m.readjson(path);
	if (type(feed?.proxies) != 'array') return { ok: false, error: 'Список проверенных сквадов ещё не загружен.' };
	let squads = [];
	for (let p in feed.proxies) {
		if (p['x-exit-country'] != country || !p['x-exit-ip'] || !p['x-checked-at']) continue;
		push(squads, { name: p.name, exit_ip: p['x-exit-ip'], country,
			ipify_ip: p['x-ipify-ip'], ipify_country: p['x-ipify-country'], checked_at: p['x-checked-at'] });
	}
	return { ok: true, squads };
};

return { 'mihomo-mini': {
	status: { call: function() { return m.status(); } },
	germany_squads: { call: function() { return squad_observations('DE', '/etc/mihomo/proxies/germany-aggregated.yaml'); } },
	finland_squads: { call: function() { return squad_observations('FI', '/etc/mihomo/proxies/finland-aggregated.yaml'); } },
	config: {
		args: { previous: false },
		call: function(req) {
			let path = req.args.previous ? m.STORE + '/config.previous.yaml' : m.CONFIG;
			let content = fs.readfile(path);
			if (content == null) return { ok: false, error: 'Файл конфигурации не найден.' };
			return { ok: true, content, hash: m.hash_config(), previous: req.args.previous };
		}
	},
	job: {
		args: { id: '' },
		call: function(req) {
			if (!match(req.args.id || '', /^job-[a-zA-Z0-9]+$/)) return { ok: false, error: 'Некорректный номер задачи.' };
			m.status();
			let r = m.readjson(m.TMP + '/' + req.args.id + '/result.json');
			return r ? { ok: true, result: r } : { ok: false, error: 'Задача не найдена.' };
		}
	},
	action: {
		args: { action: '', content: '', base: '' },
		call: function(req) { return m.enqueue(req.args.action, req.args.content, req.args.base); }
	},
	direct: { call: function() { return m.direct(); } }
} };
