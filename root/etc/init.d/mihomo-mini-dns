#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
# rc.common reads these service variables.
# Guard starts before WAN and dnsmasq. Disabled core autostart leaves DNS unarmed.
USE_PROCD=1
START=18
STOP=11

boot() {
    /usr/libexec/mihomo-mini-dns boot || return 1
    start
}

start_service() {
    procd_open_instance watcher
    procd_set_param command /usr/libexec/mihomo-mini-dns watch
    procd_set_param respawn
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
    # Forward only client DNS; dnsmasq on port 53 keeps real local/system answers.
    procd_open_instance clients
    procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/dev/null \
        --port=1056 --interface=br-lan --bind-dynamic --no-resolv --no-hosts \
        --pid-file=/var/run/mihomo-client-dns.pid --cache-size=0 \
        --server=127.0.0.1#1053 --server=/lan/local/home.arpa/in-addr.arpa/ip6.arpa/127.0.0.1#53 \
        --server=//127.0.0.1#53
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}

# A stopped watcher never removes the independent firewall guard.
